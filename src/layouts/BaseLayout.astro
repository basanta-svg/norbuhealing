---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '../styles/global.css';
import { site } from '../data/site';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SearchOverlay from '../components/ui/SearchOverlay.astro';
import ChatWidget from '../components/ui/ChatWidget.astro';

interface Props { title: string; description?: string; image?: string; type?: 'website' | 'article'; exactTitle?: boolean }
const { title, description = `${site.name}: ${site.tagline} in Thimphu, Bhutan.`, image = '/norbu-share.jpg', type = 'website', exactTitle = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = new URL(root + image, Astro.site).href;
const fullTitle = exactTitle ? title : `${title} | ${site.name}`;
const ld = {
  '@context': 'https://schema.org',
  '@type': ['HealthAndBeautyBusiness', 'LocalBusiness'],
  name: site.name,
  description: site.tagline,
  url: site.url,
  email: site.email,
  address: { '@type': 'PostalAddress', streetAddress: 'Changjalu, Olakha', addressLocality: 'Thimphu', addressCountry: 'BT' },
};
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {Astro.site?.hostname.endsWith('github.io') && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#530035" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Norbu Healing" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:bg-white focus:px-4 focus:py-2">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <SearchOverlay />
    <ChatWidget />
    <script>
      import '../scripts/smooth';
      import '../scripts/site';
      import '../scripts/form-ui';
      import '../scripts/search';
    </script>
  </body>
</html>
