---
import BaseLayout from '../layouts/BaseLayout.astro';
import DivisionAbout from '../components/ui/DivisionAbout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Button from '../components/ui/Button.astro';
import Img from '../components/ui/Img.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import CheckList from '../components/ui/CheckList.astro';
import LineIcon from '../components/ui/LineIcon.astro';
import ContactBox from '../components/ui/ContactBox.astro';
import EnquiryForm from '../components/ui/EnquiryForm.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { salonGroups } from '../data/site';
const visitors = [
  'Individuals looking for professional haircuts and styling.',
  'Clients interested in advanced hair treatments.',
  'Clients seeking facial and skincare services.',
  'Anyone looking for grooming, beauty and self-care services in Thimphu.',
];
---
<BaseLayout exactTitle title="Norbu Healing Salon | Hair & Beauty Salon in Thimphu" description="Explore haircuts, styling, hair treatments, Nanoplastia, Hydrafacial, Japanese Head Spa and beauty services at Norbu Healing Salon in Olakha, Thimphu.">
  <PageHero full eyebrow="Norbu Healing Salon" title="Professional Care for Your Beauty & Confidence." image="salon-floor" crumbs={[{ label: 'Salon' }]}
    subtitle="Discover personalized hair, skincare and beauty services at Norbu Healing Salon. Our salon brings professional care and modern techniques together in a welcoming environment, helping clients look and feel their best.">
    <Button href="#book" variant="light" arrow>Book a Salon Service</Button>
    <Button href="#services" variant="outline">Explore Services</Button>
  </PageHero>

  <DivisionAbout dept="salon" id="about-salon" label="About Norbu Healing Salon" title="A professional beauty and grooming destination" image="salon-floor-2" imageAlt="Styling stations at Norbu Healing Salon" primary={["Book a salon service", "#book"]} secondary={["Our services", "#services"]}>
    <p>Norbu Healing Salon offers hair services, advanced hair treatments, skincare, facials and personal care. We focus on enhancing natural beauty while respecting the health and condition of hair and skin.</p>
    <p>Our team aims to understand each client’s preferences and lifestyle, discuss suitable options and provide a comfortable service experience.</p>
    <h3>Our approach</h3>
    <p>We use modern techniques and professional products appropriate to the service, with personalized consultations to help clients choose options that fit their preferences. Service availability, suitability, pricing and expected results are discussed before treatment.</p>
  </DivisionAbout>

  <section id="services" class="wash-sage scroll-mt-24 section-pad" aria-labelledby="services-title">
    <div class="container-site">
      <SectionHead center id="services-title" label="Our services" title="Hair, skincare & beauty" lead="Each service can include a description, price, duration and aftercare notes — please enquire for current details." />
      <div class="mt-14 grid gap-6 md:grid-cols-2">
        {salonGroups.map((g, i) => (
          <article class="card reveal flex flex-col sm:p-10" style={`--d:${(i % 2) * 100}ms`}>
            <LineIcon name={g.icon as any} class="icon-circle-lg" />
            <h3 class="mt-5">{g.title}</h3>
            <p class="mt-3 text-gray-600">{g.text}</p>
            <div class="mt-6 flex-1"><CheckList items={g.items} /></div>
            <div class="mt-8"><Button href="#book" variant="outline-dark" class="!px-5">Book Now</Button></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="wash-sage section-pad" aria-labelledby="client-title">
    <div class="container-site grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHead label="Client experience" id="client-title" title="Time for yourself, with professional care" />
        <p class="reveal mt-6 text-gray-600" style="--d:150ms">We provide a comfortable and welcoming environment where clients can take time for themselves while receiving professional beauty care. Our goal is to make every visit clear, convenient and personalized.</p>
      </div>
      <div class="reveal">
        <h3 >Who should visit?</h3>
        <div class="mt-6"><CheckList items={visitors} /></div>
      </div>
    </div>
  </section>

  <section id="book" class="wash-ivory scroll-mt-24 section-pad" aria-labelledby="book-title">
    <div class="container-site grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-14">
      <div>
        <SectionHead id="book-title" label="Contact & booking" title="Book a Salon Service" />
        <div class="reveal mt-8"><ContactBox dept="salon" hours cta="Book a Salon Service" ctaHref="#book-form" /></div>
      </div>
      <div id="book-form" class="reveal rounded-[28px] bg-white p-6 shadow-card sm:p-10">
        <EnquiryForm kind="salon" light />
      </div>
    </div>
  </section>

  <FinalCta />
</BaseLayout>
