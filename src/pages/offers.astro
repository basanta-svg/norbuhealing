---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Img from '../components/ui/Img.astro';
import Button from '../components/ui/Button.astro';
import { activeOffers } from '../lib/offers';
import { departments, site } from '../data/site';
const offers = await activeOffers();
const deptHref: Record<string, string> = Object.fromEntries(departments.map((d) => [d.short === 'Healing' ? 'Wellness' : d.short, d.href]));
---
<BaseLayout title="Offers & Announcements" description="Current seasonal promotions, wellness packages, salon offers, hotel packages, membership offers and training announcements at Norbu Healing in Thimphu.">
  <PageHero title="Offers & Announcements" crumbs={[{ label: 'Offers' }]} image="spa-room"
    subtitle="Seasonal promotions, wellness packages, salon offers, hotel packages, membership offers and training announcements." />
  <section class="section-pad">
    <div class="container-site">
      {offers.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {offers.map((o, i) => (
            <article class="card reveal flex flex-col !p-0 overflow-hidden" style={`--d:${(i % 3) * 80}ms`}>
              {o.data.image && <div class="img-zoom aspect-[16/10] overflow-hidden"><Img name={o.data.image} alt="" class="h-full w-full object-cover" sizes="(min-width:1024px) 420px, 100vw" /></div>}
              <div class="flex flex-1 flex-col p-8">
                <p class="label text-gold-600">{o.data.kind} · {o.data.department}</p>
                <h2 class="mt-3 !text-2xl">{o.data.title}</h2>
                <p class="mt-3 flex-1 text-gray-600">{o.data.summary}</p>
                {o.data.expires && <p class="mt-4 text-sm text-gray-600">Valid until {o.data.expires.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</p>}
                <div class="mt-6"><Button href={deptHref[o.data.department] ?? '/contact/'} variant="outline-dark" arrow class="!px-5">Learn more</Button></div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="reveal mx-auto max-w-2xl rounded-[28px] bg-white p-10 text-center shadow-card">
          <h2 class="!text-3xl">No offers are running right now</h2>
          <p class="mt-4 text-gray-600">New seasonal promotions, wellness packages and training announcements are posted here as soon as they are available. To ask about current packages, contact the relevant department.</p>
          <div class="mt-8 flex flex-wrap justify-center gap-5"><Button href="/contact/" arrow>Contact Norbu Healing</Button><Button href={`mailto:${site.email}`} variant="outline-dark">Email Us</Button></div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
