---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import EnquiryForm from '../components/ui/EnquiryForm.astro';
import LineIcon from '../components/ui/LineIcon.astro';
const choices = [
  { key: 'healing', label: 'Healing & Wellness', icon: 'lotus' },
  { key: 'hotel', label: 'Hotel', icon: 'candle' },
  { key: 'salon', label: 'Salon', icon: 'sun' },
  { key: 'institute', label: 'Training / Course', icon: 'leaf' },
] as const;
---
<BaseLayout title="Book Now" description="Book or enquire about a healing session, hotel stay, salon service or training course at Norbu Healing in Thimphu, Bhutan.">
  <PageHero title="What would you like to book?" crumbs={[{ label: 'Book' }]} image="restaurant" subtitle="Choose a department below. Every form is an enquiry — our team will contact you to confirm." />
  <section class="section-pad">
    <div class="container-site max-w-3xl">
      <div role="tablist" aria-label="What would you like to book?" class="grid grid-cols-2 gap-3 sm:grid-cols-4" data-book-tabs>
        {choices.map((c, i) => (
          <button type="button" role="tab" id={`tab-${c.key}`} aria-controls={`panel-${c.key}`} aria-selected={i === 0 ? 'true' : 'false'} data-key={c.key}
            class="flex flex-col items-center gap-2 rounded-[20px] border border-sage-900/20 bg-white px-3 py-5 text-sage-900 transition hover:border-sage-900 aria-selected:border-sage-900 aria-selected:bg-sage-900 aria-selected:text-white">
            <LineIcon name={c.icon} class="icon-circle-sm [[aria-selected=true]_&]:!bg-white/15 [[aria-selected=true]_&]:!text-white" /><span class="label !text-[0.66rem] text-center">{c.label}</span>
          </button>
        ))}
      </div>
      <div class="mt-10 rounded-[28px] bg-white p-6 shadow-card sm:p-10">
        {choices.map((c) => (
          <div role="tabpanel" id={`panel-${c.key}`} aria-labelledby={`tab-${c.key}`} data-panel={c.key} class="[&:not(:first-child)]:mt-12">
            <h2 class="mb-6 !text-3xl">{c.label}</h2>
            <EnquiryForm kind={c.key} light id={`b-${c.key}`} />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Show one panel at a time; without JavaScript all four forms stay visible.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-book-tabs] [role=tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const show = (key: string) => {
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.key === key)));
    panels.forEach((p) => { p.hidden = p.dataset.panel !== key; });
  };
  const wanted = new URLSearchParams(location.search).get('type');
  show(tabs.some((t) => t.dataset.key === wanted) ? wanted! : 'healing');
  tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.key!)));
</script>
