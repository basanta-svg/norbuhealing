---
import Img from '../ui/Img.astro';
---
<section class="container-site" aria-labelledby="commitment-title">
  <div class="img-zoom reveal relative flex min-h-[420px] items-center justify-center overflow-hidden rounded-t-[60px] rounded-b-[24px] px-6 py-20 text-center text-white lg:min-h-[520px] lg:rounded-t-[100px]" data-reveal="scale">
    <Img name="reception" alt="" class="absolute inset-0 h-full w-full object-cover" sizes="(min-width:1320px) 1256px, 100vw" widths={[800, 1280, 1600]} />
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative max-w-3xl">
      <p class="label !text-white/80">Our Commitment</p>
      <h2 id="commitment-title" class="mt-4 !text-white">Care and quality in every detail</h2>
      <p class="mt-6 text-white/85">We are committed to delivering care and quality in every detail — from the attention given during a treatment to the comfort of a guest’s stay and the practical learning experience of a trainee.</p>
      <p class="mt-4 text-white/85">At Norbu Healing, we aim to do more than provide services. We strive to create positive, memorable experiences that people can return to with confidence.</p>
    </div>
  </div>
</section>
