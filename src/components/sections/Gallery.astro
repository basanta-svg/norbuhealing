---
import { Image, getImage } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { img, altFor } from '../../lib/images';
import SectionHead from '../ui/SectionHead.astro';

// Photos grouped by department. Add a name from src/assets/images to show another one.
const tabs = ['All', 'Healing', 'Hotel', 'Salon', 'Dining'] as const;
const photos: [string, (typeof tabs)[number]][] = [
  ['lobby', 'Hotel'], ['spa-window', 'Healing'], ['salon-hall', 'Salon'], ['room-couple', 'Hotel'],
  ['spa-bed', 'Healing'], ['restaurant', 'Dining'], ['salon-chair', 'Salon'], ['room-twin', 'Hotel'],
  ['spa-room-2', 'Healing'], ['salon-floor', 'Salon'], ['reception', 'Hotel'], ['therapist', 'Healing'],
  ['bath-1', 'Hotel'], ['salon-moon', 'Salon'], ['spa-twin', 'Healing'], ['salon-floor-2', 'Salon'],
  ['room-desk', 'Hotel'], ['spa-room', 'Healing'], ['salon-chair-2', 'Salon'], ['bath-2', 'Hotel'],
];
const featuredCount = 9; // what "All" shows before a tab is picked
const items = await Promise.all(photos.map(async ([name, group], i) => {
  const meta = img(name);
  const full = await getImage({ src: meta, width: 1800, format: 'webp' });
  return { name, group, meta, alt: altFor(name), full: full.src, i, featured: i < featuredCount };
}));
const dept: Record<string, string> = { Healing: 'Healing Arts Centre', Hotel: 'Hotel', Salon: 'Salon', Dining: 'Restaurant' };
---
<section class="section-pad" aria-labelledby="gallery-title" data-gallery>
  <div class="container-site">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <SectionHead id="gallery-title" label="Gallery" title="Explore the Norbu Healing environment" lead="Treatment rooms, hotel rooms, the salon floor and the restaurant: a look inside before you visit." />
      <div role="group" aria-label="Filter photos by department" class="gallery-tabs reveal">
        {tabs.map((t, n) => <button type="button" data-tab={t} aria-pressed={n === 0 ? 'true' : 'false'}>{t}</button>)}
      </div>
    </div>

    <ul class="gallery-grid mt-10" data-gallery-grid>
      {items.map((p) => (
        <li class="gallery-item" data-group={p.group} data-featured={p.featured ? 'true' : 'false'}>
          <button type="button" class="gallery-open" data-full={p.full} data-alt={p.alt} data-dept={dept[p.group]} aria-label={`View photo: ${p.alt}`}>
            <Image src={p.meta} alt={p.alt} widths={[400, 700, 1000]} sizes="(min-width:1024px) 400px, (min-width:640px) 50vw, 100vw" class="gallery-img" loading="lazy" format="webp" />
            <span class="gallery-cap">
              <span class="label !text-[0.62rem] !tracking-[0.3em] !text-white/80">{dept[p.group]}</span>
              <span class="gallery-title">{p.alt}</span>
            </span>
            <span class="gallery-zoom" aria-hidden="true"><Icon name="norbu-search" class="h-5 w-5" /></span>
          </button>
        </li>
      ))}
    </ul>

    <div class="mt-10 text-center">
      <button type="button" class="btn btn-outline-dark" data-gallery-more>Show all photos</button>
    </div>
  </div>

  <dialog class="lightbox" data-lightbox aria-label="Photo viewer">
    <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Close photo viewer"><Icon name="norbu-close" class="h-6 w-6" /></button>
    <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label="Previous photo"><Icon name="norbu-arrow-right" class="h-6 w-6 rotate-180" /></button>
    <button type="button" class="lb-btn lb-next" data-lb-next aria-label="Next photo"><Icon name="norbu-arrow-right" class="h-6 w-6" /></button>
    <figure class="lb-fig">
      <img alt="" data-lb-img />
      <figcaption><span class="label !text-[0.68rem] !text-white/70" data-lb-dept></span><span data-lb-cap></span><span class="lb-count" data-lb-count></span></figcaption>
    </figure>
  </dialog>
</section>

<style is:global>
  .gallery-tabs { display: flex; flex-wrap: wrap; gap: .5rem; }
  .gallery-tabs button {
    border: 1.5px solid var(--color-plum-border); color: var(--color-plum); border-radius: 999px; padding: .55rem 1.25rem;
    font-size: .9375rem; font-weight: 600; transition: background-color .2s, color .2s, border-color .2s;
  }
  .gallery-tabs button:hover { background: var(--color-plum-section); }
  .gallery-tabs button[aria-pressed='true'] { background: var(--color-plum); border-color: var(--color-plum); color: #fff; }

  /* masonry: photos keep their natural proportions */
  .gallery-grid { columns: 1; column-gap: 1rem; }
  @media (min-width: 640px) { .gallery-grid { columns: 2; } }
  @media (min-width: 1024px) { .gallery-grid { columns: 3; column-gap: 1.25rem; } }
  .gallery-item { break-inside: avoid; margin-bottom: 1rem; }
  @media (min-width: 1024px) { .gallery-item { margin-bottom: 1.25rem; } }
  .gallery-item[hidden] { display: none; }
  .gallery-item.is-entering { animation: gal-in .45s ease both; }
  @keyframes gal-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  .gallery-open { position: relative; display: block; width: 100%; overflow: hidden; border-radius: 16px; background: var(--color-plum-section); cursor: zoom-in; }
  .gallery-img { display: block; width: 100%; height: auto; transition: transform .7s cubic-bezier(.2,.7,.2,1); }
  .gallery-open:hover .gallery-img, .gallery-open:focus-visible .gallery-img { transform: scale(1.04); }
  .gallery-cap {
    position: absolute; inset-inline: 0; bottom: 0; display: flex; flex-direction: column; gap: .15rem; padding: 2.5rem 1.1rem 1rem; text-align: left; color: #fff;
    background: linear-gradient(to top, rgb(0 0 0 / 0.8), transparent); opacity: 0; transform: translateY(8px); transition: opacity .3s, transform .3s;
  }
  .gallery-title { font-size: .95rem; font-weight: 600; line-height: 1.3; }
  .gallery-open:hover .gallery-cap, .gallery-open:focus-visible .gallery-cap { opacity: 1; transform: none; }
  @media (hover: none) { .gallery-cap { opacity: 1; transform: none; } }
  .gallery-zoom {
    position: absolute; top: .8rem; right: .8rem; display: flex; align-items: center; justify-content: center; width: 2.5rem; height: 2.5rem; border-radius: 999px;
    background: #fff; color: var(--color-plum); opacity: 0; transform: scale(.85); transition: opacity .25s, transform .25s;
  }
  .gallery-open:hover .gallery-zoom, .gallery-open:focus-visible .gallery-zoom { opacity: 1; transform: none; }

  .lightbox { position: fixed; inset: 0; margin: 0; width: 100%; max-width: none; height: 100%; max-height: none; padding: 0; border: 0; background: rgb(16 16 16 / 0.97); color: #fff; }
  .lightbox:not([open]) { display: none; }
  .lightbox[open] { animation: lb-in .5s cubic-bezier(.22, 1, .36, 1) both; }
  @keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }
  .lb-fig img { animation: lb-img .6s cubic-bezier(.22, 1, .36, 1) both; }
  @keyframes lb-img { from { opacity: 0; transform: scale(.97); } to { opacity: 1; transform: none; } }
  .lightbox::backdrop { background: transparent; }
  .lb-fig { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; padding: 4.5rem 1rem 1.5rem; }
  @media (min-width: 768px) { .lb-fig { padding-inline: 6rem; } }
  .lb-fig img { max-width: 100%; max-height: calc(100vh - 11rem); width: auto; height: auto; object-fit: contain; border-radius: 12px; }
  .lb-fig figcaption { display: flex; flex-direction: column; align-items: center; gap: .25rem; margin-top: 1rem; text-align: center; font-weight: 600; }
  .lb-count { font-size: .8125rem; color: rgb(255 255 255 / 0.6); font-weight: 500; }
  .lb-btn {
    position: absolute; z-index: 2; display: flex; align-items: center; justify-content: center; width: 3rem; height: 3rem; border-radius: 999px;
    border: 1.5px solid rgb(255 255 255 / 0.4); color: #fff; transition: background-color .2s;
  }
  .lb-btn:hover { background: rgb(255 255 255 / 0.16); }
  .lb-close { top: 1rem; right: 1rem; }
  .lb-prev, .lb-next { top: 50%; translate: 0 -50%; }
  .lb-prev { left: 1rem; }
  .lb-next { right: 1rem; }
  @media (max-width: 767px) { .lb-prev, .lb-next { top: auto; bottom: 1rem; translate: none; } .lb-fig img { max-height: calc(100vh - 14rem); } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const grid = root.querySelector<HTMLElement>('[data-gallery-grid]')!;
    const tiles = [...grid.querySelectorAll<HTMLElement>('.gallery-item')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const more = root.querySelector<HTMLButtonElement>('[data-gallery-more]')!;
    let tab = 'All';
    let expanded = false;

    const visible = () => tiles.filter((t) => !t.hidden);
    const apply = () => {
      tiles.forEach((t) => {
        const inTab = tab === 'All' || t.dataset.group === tab;
        const show = inTab && (tab !== 'All' || expanded || t.dataset.featured === 'true');
        if (show && t.hidden) t.classList.add('is-entering');
        t.hidden = !show;
        if (!show) t.classList.remove('is-entering');
      });
      more.hidden = tab !== 'All' || expanded;
    };
    tabs.forEach((b) => b.addEventListener('click', () => {
      tab = b.dataset.tab!;
      tabs.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    }));
    more.addEventListener('click', () => { expanded = true; apply(); });
    apply();

    // ---- viewer ----
    const lb = root.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const lbImg = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const lbCap = lb.querySelector<HTMLElement>('[data-lb-cap]')!;
    const lbDept = lb.querySelector<HTMLElement>('[data-lb-dept]')!;
    const lbCount = lb.querySelector<HTMLElement>('[data-lb-count]')!;
    let list: HTMLButtonElement[] = [];
    let at = 0;

    const show = (n: number) => {
      at = (n + list.length) % list.length;
      const b = list[at];
      lbImg.src = b.dataset.full!;
      lbImg.alt = b.dataset.alt ?? '';
      lbCap.textContent = b.dataset.alt ?? '';
      lbDept.textContent = b.dataset.dept ?? '';
      lbCount.textContent = `${at + 1} / ${list.length}`;
    };
    grid.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.gallery-open');
      if (!b) return;
      list = visible().map((t) => t.querySelector<HTMLButtonElement>('.gallery-open')!);
      lb.showModal();
      document.body.style.overflow = 'hidden';
      show(list.indexOf(b));
    });
    lb.querySelector('[data-lb-close]')!.addEventListener('click', () => lb.close());
    lb.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(at - 1));
    lb.querySelector('[data-lb-next]')!.addEventListener('click', () => show(at + 1));
    lb.addEventListener('close', () => { document.body.style.overflow = ''; });
    lb.addEventListener('click', (e) => { if (e.target === lb || (e.target as HTMLElement).classList.contains('lb-fig')) lb.close(); });
    lb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(at + 1);
      if (e.key === 'ArrowLeft') show(at - 1);
    });
    let x0 = 0;
    lb.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) show(at + (dx < 0 ? 1 : -1)); });
  });
</script>
