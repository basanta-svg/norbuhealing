---
// Our philosophy: a photograph beside the statement.
import Img from '../ui/Img.astro';
---
<section class="wash-sage section-pad" aria-labelledby="philosophy-title">
  <div class="container-site grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
    <div class="reveal" data-reveal="scale">
      <div class="img-zoom aspect-[4/4.4] overflow-hidden rounded-[16px] lg:aspect-[4/5]">
        <Img name="spa-twin" alt="A calm twin treatment room" class="h-full w-full object-cover" sizes="(min-width:1024px) 520px, 100vw" widths={[500, 800, 1100]} />
      </div>
    </div>

    <div>
      <p class="label reveal">Our Philosophy</p>
      <h2 id="philosophy-title" class="reveal mt-4 max-w-xl" style="--d:100ms">Heal, enhance, experience and evolve</h2>
      <div class="ph-copy">
        <p class="reveal" style="--d:180ms">We believe well-being is more than a single experience. It includes caring for the body, making time for personal confidence, feeling comfortable and welcome, and building skills for the future.</p>
        <p class="reveal" style="--d:260ms">At Norbu Healing, our aim is to create an environment where people can heal, enhance, experience and evolve — all under one trusted brand.</p>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .ph-copy { margin-top: 1.75rem; padding-top: 1.75rem; border-top: 1px solid var(--color-plum-border); max-width: 34rem; }
  .ph-copy p { font-size: 1.0625rem; line-height: 1.7; color: #2a2a2a; }
  .ph-copy p + p { margin-top: 1.1rem; }
</style>
