---
import Button from '../ui/Button.astro';
import SectionHead from '../ui/SectionHead.astro';
import { activeOffers } from '../../lib/offers';
const offers = (await activeOffers()).slice(0, 3);
---
<section class="section-pad" aria-labelledby="offers-title">
  <div class="container-site">
    <SectionHead center id="offers-title" label="Offers & Announcements" title="Current offers across Norbu Healing" lead="Discover current seasonal promotions, wellness packages, salon offers, hotel packages, membership offers and training announcements." />
    {offers.length > 0 && (
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {offers.map((o, i) => (
          <a href="/offers/" class="card reveal block transition hover:-translate-y-1" style={`--d:${i * 80}ms`}>
            <p class="label text-gold-600">{o.data.kind} · {o.data.department}</p>
            <h3 class="mt-3 !text-[1.3rem]">{o.data.title}</h3>
            <p class="mt-3 text-[0.92rem] text-gray-600">{o.data.summary}</p>
          </a>
        ))}
      </div>
    )}
    <div class="reveal mt-10 text-center"><Button href="/offers/" arrow>View All Offers</Button></div>
  </div>
</section>
