---
interface Props { n?: number }
const { n = 5 } = Astro.props;
---
<div class="flex justify-center gap-1 text-gold-600" role="img" aria-label={`${n} out of 5 stars`}>
  {Array.from({ length: 5 }, (_, i) => (
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill={i < n ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z" /></svg>
  ))}
</div>
