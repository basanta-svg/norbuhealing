---
import { Icon } from 'astro-icon/components';
interface Props { items: string[]; light?: boolean; cols?: boolean }
const { items, light = false, cols = false } = Astro.props;
---
<ul class:list={['grid gap-3', cols && 'sm:grid-cols-2']}>
  {items.map((i) => (<li class="flex items-start gap-3"><Icon name="norbu-lotus" class:list={['mt-0.5 h-5 w-5 shrink-0', light ? 'text-gold-100' : 'text-gold-600']} /><span>{i}</span></li>))}
</ul>
