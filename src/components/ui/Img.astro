---
import { Image } from 'astro:assets';
import { img, altFor } from '../../lib/images';

interface Props {
  name: string;
  alt?: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}
const { name, alt, class: cls, widths = [480, 800, 1200], sizes = '100vw', loading = 'lazy', fetchpriority } = Astro.props;
---
<Image src={img(name)} alt={alt ?? altFor(name)} class={cls} widths={widths} sizes={sizes} loading={loading} fetchpriority={fetchpriority} format="webp" />
